DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://sejm:sejm@localhost:5432/sejmwatch

SEJM_TERM=10
SEJM_HTTP_WORKERS=8

# --- Oświadczenia majątkowe -------------------------------------------------
# mock    - dane demonstracyjne, działa bez kluczy
# ocr_llm - PaddleOCR (lokalnie) + model LLM; wymaga: uv sync --extra ocr oraz konfiguracji LLM_* poniżej
ASSET_EXTRACTOR=mock
# Przerwa (w sekundach) między żądaniami do sejm.gov.pl i ORKA przy: manage.py sync_declarations --fetch
DECLARATION_FETCH_DELAY=0.5
# Poniżej tej pewności (0-1) oświadczenie trafia do weryfikacji ręcznej
ASSET_REVIEW_THRESHOLD=0.7

# --- OCR (PaddleOCR, lokalnie) ----------------------------------------------
OCR_ENGINE=paddle
OCR_LANG=pl
# cpu | gpu | gpu:0
OCR_DEVICE=cpu
# Skala renderowania stron PDF. Wyżej = dokładniej, ale wolniej (ok. 20 s/stronę na CPU przy 1.6)
OCR_RENDER_SCALE=1.6

# --- LLM (dowolny dostawca z API zgodnym z OpenAI /chat/completions) --------
# Gotowe adresy: openai | openrouter | groq | together | mistral | deepseek | ollama | lmstudio | vllm
# Własny dostawca: ustaw LLM_BASE_URL (ma pierwszeństwo przed LLM_PROVIDER).
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=180
# Puste = nie wysyłaj (np. modele, które nie przyjmują temperature)
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=
# json_object (domyślnie, najszerzej wspierane) | json_schema | none
LLM_RESPONSE_FORMAT=json_object
# Opcjonalnie, w formacie JSON, np. {"HTTP-Referer": "https://moja.app"}
LLM_EXTRA_HEADERS={}
# Opcjonalnie dodatkowe pola żądania, np. {"reasoning_effort": "low"} albo {"options": {"num_ctx": 16384}}
LLM_EXTRA_BODY={}
# Ile razy model może poprawić odpowiedź po błędach walidacji
LLM_MAX_REPAIRS=2
